# toolchains and downloads
.deps/
# 汉化时用到的中文字体源文件（按 docs/LOCALIZATION.md 自己下，烘焙产物才进 git）
.deps/fonts/

# 汉化时的原文备份（scripts/apply-translations.py 生成）
*.en.bak

# build outputs
build/
*.elf
*.o
*.a

# models never go in git
*.gguf
models/

.DS_Store
.wrangler/

# the app's home screen backgrounds, made from ps5/app/sce_sys/source by scripts/build-app.sh
ps5/app/sce_sys/*.dds

# Python bytecode from the fleet controller and its tests
__pycache__/
*.pyc

# the fleet control server's settings (python3 -m fleet control)
fleet/control.json
fleet/control.json.tmp
